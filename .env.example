# Anjungan Nagari Mandiri - Environment Variables

# App Configuration
NODE_ENV=development
PORT=3002

# AI Service (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Fresh Info Search API
# Supported providers: tavily, serpapi
SEARCH_API_PROVIDER=tavily
SEARCH_API_KEY=your_search_api_key_here
SEARCH_API_TIMEOUT_MS=8000

# Backend API
BACKEND_URL=http://localhost:8000/api

# Database
DB_PATH=./data/kiosk.db

# Audio Cache
AUDIO_CACHE_DIR=./data/audio_cache
