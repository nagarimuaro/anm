{
  "name": "anm",
  "version": "1.0.0",
  "description": "Anjungan Nagari Mandiri — AI Voice Kiosk (Offline-First)",
  "main": "src/app/main.js",
  "scripts": {
    "start": "webpack serve --mode development",
    "electron": "electron .",
    "dev": "concurrently \"npm start\" \"wait-on http://localhost:3002 && npm run electron\"",
    "build:web": "webpack --mode production",
    "build:win": "npm run build:web && electron-builder --win --x64 --ia32"
  },
  "build": {
    "appId": "com.sintanagari.anmkiosk",
    "productName": "SINTA",
    "directories": {
      "output": "release/"
    },
    "win": {
      "target": "nsis",
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "src/app/**/*",
      "src/infrastructure/**/*",
      "src/modules/**/*",
      ".env"
    ],
    "extraResources": [
      {
        "from": "public/models",
        "to": "models"
      }
    ]
  },
  "keywords": [
    "kiosk",
    "voice-ai",
    "electron",
    "nagari"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@vladmandic/face-api": "^1.7.15",
    "dotenv": "^17.3.1",
    "express": "^4.21.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3",
    "systeminformation": "^5.31.5",
    "uuid": "^9.0.0",
    "ws": "^8.20.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@babel/core": "^7.24.3",
    "@babel/preset-env": "^7.24.3",
    "@babel/preset-react": "^7.24.1",
    "babel-loader": "^9.1.3",
    "concurrently": "^8.2.2",
    "css-loader": "^6.10.0",
    "electron": "^29.1.5",
    "electron-builder": "^26.8.1",
    "html-webpack-plugin": "^5.6.0",
    "style-loader": "^3.3.4",
    "wait-on": "^7.2.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  }
}